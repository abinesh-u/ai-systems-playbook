{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Systems Playbook Publication Package",
  "type": "object",
  "required": ["id", "status", "content_type", "owner", "title", "slug", "seo", "evidence", "links", "reviews", "publication"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "status": {"enum": ["planning", "ready-for-draft", "ready-for-publishing"]},
    "content_type": {"enum": ["article", "pillar", "tutorial", "case-study", "reference"]},
    "owner": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "seo": {
      "type": "object",
      "required": ["intent", "description", "canonical_url"],
      "properties": {
        "intent": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["research_records", "archive_assets", "claim_limits"],
      "properties": {
        "research_records": {"type": "array", "items": {"type": "string"}},
        "archive_assets": {"type": "array", "items": {"type": "string"}},
        "claim_limits": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "links": {
      "type": "object",
      "required": ["parent", "related", "references"],
      "properties": {
        "parent": {"type": "string"},
        "related": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "reviews": {
      "type": "object",
      "required": ["technical", "architecture", "editorial", "seo", "readiness"],
      "properties": {
        "technical": {"enum": ["pending", "pass", "fail"]},
        "architecture": {"enum": ["pending", "pass", "fail"]},
        "editorial": {"enum": ["pending", "pass", "fail"]},
        "seo": {"enum": ["pending", "pass", "fail"]},
        "readiness": {"enum": ["pending", "pass", "fail"]}
      },
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "required": ["diagram_plan", "project_integration", "adaptation_notes"],
      "properties": {
        "diagram_plan": {"type": "string", "minLength": 1},
        "project_integration": {"type": "string", "minLength": 1},
        "adaptation_notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
